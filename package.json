{
  "name": "paseo-bridge-pi",
  "version": "0.1.0",
  "description": "Surface terminal-started pi TUI sessions in Paseo, live and steerable.",
  "type": "module",
  "license": "MIT",
  "author": "Caelan <git@caesay.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/caesay/paseo-bridge-pi"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extension"
    ]
  },
  "files": [
    "shim",
    "extension",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "dev-install": "node scripts/install.js",
    "dev-uninstall": "node scripts/uninstall.js",
    "test": "node --experimental-strip-types --test test/*.test.js"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0"
  },
  "dependencies": {
    "@getpaseo/client": "0.15.3",
    "@getpaseo/protocol": "0.15.3"
  }
}
